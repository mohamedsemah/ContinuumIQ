# Contact form — Resend (https://resend.com)
#
# Testing sender (onboarding@resend.dev): Resend only allows ONE “to” address — the email you
# signed up with (shown in the 403 error). You cannot send to Gmail/other addresses until you
# verify your own domain at https://resend.com/domains and set RESEND_FROM_EMAIL to e.g.
# "ContinuumIQ <hello@yourdomain.com>". Then CONTACT_TO_EMAIL can be any inbox.
#
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="ContinuumIQ <onboarding@resend.dev>"
CONTACT_TO_EMAIL=same-as-your-resend-login@example.com

# Optional (already documented in README)
# NEXT_PUBLIC_GA_ID=
